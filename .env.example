# ─────────────────────────────────────────
#  Discord Management Bot — Environment
# ─────────────────────────────────────────

# Your bot token (from Discord Developer Portal)
TOKEN=your_bot_token_here

# Your application/client ID (from Discord Developer Portal)
CLIENT_ID=your_client_id_here

# ─────────────────────────────────────────
#  Web Dashboard (web/server.js) — optional
#  Only needed if you're running the dashboard, not the bot itself.
# ─────────────────────────────────────────

# Same as CLIENT_ID above — kept separate since these are conventionally
# named this way in OAuth2 docs and the dashboard reads this exact name.
DISCORD_CLIENT_ID=your_client_id_here

# From Discord Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI registered in the Developer Portal
# (Discord Developer Portal → OAuth2 → Redirects)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Any long random string — used to sign session cookies. Must be at least
# 32 characters (enforced at startup). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# Port the dashboard listens on (default 3000)
DASHBOARD_PORT=3000

# Permission integer requested when a user clicks "Add to Server".
# Default below covers everything this bot's commands need, including
# joining/speaking in voice channels for music — regenerate via Discord
# Developer Portal → OAuth2 → URL Generator if you add commands that need
# more permissions than this.
BOT_INVITE_PERMISSIONS=1099783210054

# ─────────────────────────────────────────
#  Music (Lavalink) — see docs/MUSIC_SETUP.md for full setup instructions
# ─────────────────────────────────────────

# Your own Lavalink node (recommended — e.g. lavalink.shanufx.dev). If left
# blank, the bot runs on free public fallback nodes only, which is fine for
# testing but not recommended long-term (shared load, can disappear anytime).
LAVALINK_HOST=
LAVALINK_PORT=443
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=true

# Set to false to disable the free public Lavalink nodes used as automatic
# fallback when your own node (above) is unreachable.
LAVALINK_ENABLE_PUBLIC_FALLBACK=true

# Optional: connect to a Lavalink instance running locally (e.g. via
# `docker compose up lavalink`, see docs/MUSIC_SETUP.md) — useful for
# development without touching your production node.
LAVALINK_LOCAL_ENABLED=false
LAVALINK_LOCAL_HOST=localhost
LAVALINK_LOCAL_PORT=2333
LAVALINK_LOCAL_PASSWORD=youshallnotpass

# Optional: add more nodes as raw JSON without editing code, e.g.
# LAVALINK_EXTRA_NODES=[{"id":"extra1","host":"example.com","port":443,"authorization":"pass","secure":true}]
LAVALINK_EXTRA_NODES=

# Spotify support works without any keys here (see docs/MUSIC_SETUP.md for
# how — keyless metadata resolution + YouTube Music search). To get native,
# higher-quality Spotify resolution instead, install the LavaSrc plugin on
# YOUR Lavalink node (LAVALINK_HOST above) and give it a free Spotify
# Developer app's Client ID/Secret directly in that node's application.yml —
# this bot doesn't need those credentials itself.

# ── Only used by the `lavalink` container in docker-compose.yml ────────────
# (not read by the bot process itself — the bot only ever needs LAVALINK_HOST/
# PORT/PASSWORD/SECURE above to connect to whatever node those point at).
# If you're running Lavalink via docker-compose (recommended — see
# docs/VPS_DEPLOY_GUIDE.md), LAVALINK_PASSWORD above IS the password the
# container starts with (lavalink/application.yml reads it from this same
# .env file) — you don't set it twice, just fill it in once above.

# Optional — free Spotify Developer app credentials (developer.spotify.com/dashboard),
# only used by the LavaSrc plugin inside the `lavalink` container for native
# Spotify metadata. Leave blank to rely on the bot's built-in keyless fallback
# instead (works fine, just uses YouTube Music search matching).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — Java heap size for the lavalink container (default -Xmx1G).
# Bump this on a bigger VPS if you expect a lot of concurrent players.
LAVALINK_JAVA_OPTS=-Xmx1G

