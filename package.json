{
  "name": "discord-management-bot",
  "version": "1.0.0",
  "description": "Production-ready Discord server management bot built with Discord.js v14",
  "main": "index.js",
  "scripts": {
    "start": "node shard.js",
    "start:single": "node index.js",
    "dev": "node --watch index.js",
    "deploy:guild": "node deploy-commands.js guild",
    "deploy:global": "node deploy-commands.js global",
    "dashboard": "node web/server.js",
    "dashboard:dev": "node --watch web/server.js",
    "smoke-test": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@discordjs/rest": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "discord-api-types": "^0.38.0",
    "discord.js": "^14.15.0",
    "dotenv": "^16.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "lavalink-client": "^2.10.3",
    "spotify-url-info": "^3.3.1"
  },
  "keywords": ["discord", "bot", "moderation", "discord.js"],
  "license": "MIT"
}
