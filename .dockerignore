# =====================================
#  Discord Bot .dockerignore
# =====================================
# Files and directories to exclude from Docker build context
# This speeds up builds and reduces image size

# ── Git & Version Control ────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/
.gitlab-ci.yml

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── Documentation ────────────────────────────────────────────────────────────
README.md
README_FIRST.txt
*.md
docs/
!DEPLOYMENT.md

# ── Development Files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# ── Database & Data ──────────────────────────────────────────────────────────
# Don't include local data in image (mount as volume instead)
data/
*.db
*.db-shm
*.db-wal

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
lavalink/logs/

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.yml
docker-compose.*.yml
Dockerfile
.dockerignore

# ── Environment & Secrets ────────────────────────────────────────────────────
# NEVER include secrets in Docker images
.env
.env.*
!.env.example

# ── Test & CI/CD ─────────────────────────────────────────────────────────────
test/
tests/
coverage/
.nyc_output/
*.test.js
*.spec.js

# ── Build Output ─────────────────────────────────────────────────────────────
dist/
build/
.cache/

# ── Temporary ────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.swp
*.swo

# ── Lavalink (separate service) ──────────────────────────────────────────────
lavalink/
!lavalink/application.yml

# ── Scripts (only include what's needed) ─────────────────────────────────────
scripts/
!scripts/smoke-test.js

# ── Optional Development Files ───────────────────────────────────────────────
*.draft.md
NOTES.md
TODO.md
SCRATCH.md

# ── Keep Essential Files ─────────────────────────────────────────────────────
# These MUST be included (remove from above if listed)
!package.json
!package-lock.json
!index.js
!shard.js
!deploy-commands.js
!commands/
!events/
!handlers/
!music/
!utils/
!db/
!web/
