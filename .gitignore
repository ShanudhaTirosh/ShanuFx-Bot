# =====================================
#  Discord Bot .gitignore
# =====================================

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
config.json

# Never commit these - they contain bot token, secrets, API keys
.env.production
.env.development
.env.test

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.yarn-integrity
.pnp
.pnp.js

# ── Database & Data ──────────────────────────────────────────────────────────
# SQLite database files (contains user data, warnings, configs)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Database backups
*.db.backup
*.sql.gz

# Old JSON config files (if migrating from JSON-based config)
config/*.json

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
lavalink.log
bot.log
dashboard.log
error.log

# Lavalink logs
lavalink/logs/

# ── Docker ───────────────────────────────────────────────────────────────────
# Docker volumes and runtime data
docker-compose.override.yml
.dockerignore.local

# ── Operating System ─────────────────────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
.Trash-*
.nfs*

# ── IDE & Editors ────────────────────────────────────────────────────────────
# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ── Build Output & Cache ─────────────────────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/
.next/
out/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
.tern-port
.eslintcache
.stylelintcache

# TypeScript build output (if using TypeScript in future)
*.tsbuildinfo
lib/
*.d.ts.map

# ── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
.jest/
test-results/
junit.xml

# ── Temporary & Misc ─────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
.lock-wscript

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# ── Lavalink Specific ────────────────────────────────────────────────────────
# Lavalink plugins (auto-downloaded on start)
lavalink/plugins/*.jar

# Lavalink application.yml should be versioned, but not local overrides
lavalink/application.local.yml

# ── Deployment & CI/CD ───────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# CI/CD secrets
.gitlab-ci-local/
.github/workflows/*.local.yml

# PM2 logs
.pm2/
pm2.log

# ── Optional: Development Files ──────────────────────────────────────────────
# Uncomment if you want to ignore development scripts
# scripts/dev-*.js
# scripts/test-*.js

# Uncomment if you want to ignore local documentation drafts
# docs/drafts/
# *.draft.md

# ── Keep These Files ─────────────────────────────────────────────────────────
# Make sure these are NOT ignored (remove from above if needed)
!.env.example
!.gitignore
!.dockerignore
!README.md
!package.json
!package-lock.json
!lavalink/application.yml
!docker-compose.yml
!Dockerfile

# ── Security Note ────────────────────────────────────────────────────────────
# NEVER commit:
# - Bot tokens (TOKEN in .env)
# - API keys (DISCORD_CLIENT_SECRET, SPOTIFY_CLIENT_ID, etc.)
# - Session secrets (SESSION_SECRET)
# - Passwords (LAVALINK_PASSWORD)
# - Database files with user data
# - Private keys or certificates
#
# ALWAYS commit:
# - .env.example (template without secrets)
# - Source code
# - Documentation
# - Configuration templates

# ── Project Specific ─────────────────────────────────────────────────────────
# Ignore backup files
*.bak
*.backup

# Ignore error dumps
crash.log
error-*.log
debug-*.log

# Ignore personal notes
NOTES.md
TODO.personal.md
SCRATCH.md

# Ignore local test files
test.js
test-*.js
scratch.js
playground.js

# =====================================
#  End of .gitignore
# =====================================
